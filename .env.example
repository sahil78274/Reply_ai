# ============================================================================
# ReplyAI - Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# ============================================================================

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27027/replyai

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_LANGUAGE=hinglish   # en | hi | hinglish
AI_PERSONA=Friendly, helpful WhatsApp Business assistant

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replyai_webhook_verify_token
WHATSAPP_API_VERSION=v22.0

# n8n integration (optional)
N8N_WEBHOOK_URL=your_n8n_webhook_url_here

# Demo mode (set "true" to run with sample data without a real WhatsApp account)
DEMO_MODE=true
SEED_DEMO=true
